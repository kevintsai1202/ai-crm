# === LLM 對話模型設定（OpenAI 相容端點）===
# 對話模型的 API 金鑰
OPENAI_API_KEY=your-openai-api-key
# 對話使用的模型名稱
OPENAI_CHAT_MODEL=gpt-4o-mini
# OpenAI 相容 API 的基底位址（自架或代理閘道時填寫）
BASE_URL=https://api.openai.com/

# === AI 用途模型部署預設 ===
# 供應商名稱必須與管理後台建立的供應商完全一致；模型也必須存在於共用模型目錄，
# 並分別標示 VISION 或 AUDIO_TRANSCRIPTION 能力。管理後台另有指派時會優先使用後台設定。
AI_OCR_PROVIDER_NAME=OpenAI
AI_OCR_MODEL=gpt-4o-mini
AI_TRANSCRIPTION_PROVIDER_NAME=OpenAI
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# === Voyage 向量嵌入設定（RAG 檢索用）===
# Voyage 嵌入服務的 API 金鑰
VOYAGE_API_KEY=your-voyage-api-key
# 嵌入模型名稱
VOYAGE_MODEL=voyage-4-lite
# 嵌入服務端點
VOYAGE_URL=https://api.voyageai.com/v1/embeddings

# === Temporary Media S3 / local MinIO ===
# 本機請自行產生高強度且不同於範例文字的帳密；勿使用 minioadmin 或提交真實 secret。
MINIO_ROOT_USER=replace-with-strong-local-user
MINIO_ROOT_PASSWORD=replace-with-at-least-16-random-characters
MEDIA_S3_ENDPOINT=http://127.0.0.1:19000
MEDIA_S3_ACCESS_KEY=replace-with-same-local-user
MEDIA_S3_SECRET_KEY=replace-with-same-random-password
MEDIA_S3_BUCKET=ai-crm-temporary-media
MEDIA_IMAGE_MAX_PIXELS=25000000
# MEDIA_TEMP_DIR=C:/temp/ai-crm-media
MEDIA_TEMP_STALE_AGE=PT24H
