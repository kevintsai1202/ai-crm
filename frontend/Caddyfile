{
	admin off
}

:80 {
	# /api/* 反向代理至後端服務，讓前後端同域（消除 CORS 跨域 + 不在 bundle 暴露後端 URL）
	route /api/* {
		reverse_proxy https://aicrm-backend-kt2026.zeabur.app {
			header_up Host {upstream_hostport}
		}
	}

	# 安全 headers（前端靜態資源層）
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:;"
		# 移除 Caddy 版本資訊
		-Server
	}

	root * /dist
	encode gzip

	# SPA fallback：所有非靜態路由回傳 index.html
	try_files {path} /index.html
	file_server
}
